<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Electron bundles V8, which needs to write and execute JIT pages.
	     Without these three the app will not launch under the hardened
	     runtime that notarization requires. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>

	<!-- The app is a wrapper around https://empanadas.io, so it needs to
	     make outbound connections. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
