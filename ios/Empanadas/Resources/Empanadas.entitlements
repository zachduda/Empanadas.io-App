<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Lets passkeys created on empanadas.io work in the app's web views.
		Needs the site to serve /.well-known/apple-app-site-association with
		this app's Team ID; see ios/SITE-CHANGES.md.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:empanadas.io</string>
	</array>
</dict>
</plist>
