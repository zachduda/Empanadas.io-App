{
  "name": "empanadas.io",
  "version": "1.12.0",
  "description": "The only app for all your Empanada needs!",
  "main": "main.js",
  "publisherName": "Empanadas.io",
  "scripts": {
    "start": "electron .",
    "start:mac": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "test": "node scripts/validate.js"
  },
  "author": "Zach Duda (https://zachduda.com)",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.16.0"
  },
  "build": {
    "appId": "io.empanadas.app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test",
      "!scripts",
      "!ios"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "zachduda",
        "repo": "Empanadas.io-App",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Empanadas.io",
        "schemes": [
          "empanadas-io"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "title": "Empanadas.io",
      "background": "build/background.png",
      "iconSize": 100,
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": true,
		"signtoolOptions": {
		  "publisherName": "Empanadas.io"
		}
    },
    "artifactName": "${name}-Setup-${version}.${ext}",
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    }
  },
  "postinstall": "electron-builder install-app-deps",
  "dependencies": {
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachduda/Empanadas.io-App.git"
  },
  "bugs": {
    "url": "https://github.com/zachduda/Empanadas.io-App/issues"
  },
  "homepage": "https://empanadas.io/download"
}
